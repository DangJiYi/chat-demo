#!/bin/sh
# pre-push 门禁：只允许推送到自己的 fork。
#
# 这个文件被 core.hooksPath 指向 .githooks/，所以会随仓库走。
# 每次 git push 前执行；命中白名单外的主机/仓库就直接失败退出。
#
# 白名单只放一条：DangJiYi/chat-demo（你自己的 fork）。
# 想加别的目标，改下面那个 case 分支——那是刻意的摩擦，别绕过它。

ALLOWED_OWNER=DanJiYi
ALLOWED_REPO=chat-demo

remote_name="$1"
remote_url="$2"

# 规范化：去掉协议前缀、凭据、.git 后缀，小写比较
norm=$(printf '%s' "$remote_url" \
    | sed -e 's#^[a-zA-Z][a-zA-Z0-9+.-]*://##' \
          -e 's#^[^@/]*@##' \
          -e 's#^[^/]*[:/]##' \
          -e 's#\.git$##' \
          -e 's#/*$##' \
    | tr '[:upper:]' '[:lower:]')

owner=$(printf '%s' "$norm" | cut -d/ -f1)
repo=$(printf '%s' "$norm" | cut -d/ -f2)

if [ "$owner" = "$(printf '%s' "$ALLOWED_OWNER" | tr '[:upper:]' '[:lower:]')" ] \
   && [ "$repo" = "$ALLOWED_REPO" ]; then
    exit 0
fi

cat >&2 <<EOF

============================================================
  推送被拒绝
============================================================

  目标 remote : $remote_name
  目标地址    : $remote_url
  解析结果    : ${owner}/${repo}

  只允许推送到 ${ALLOWED_OWNER}/${ALLOWED_REPO}（你自己的 fork）。

  这可能是：
    - 你想推上游仓库（不允许）
    - 你加了新的 remote 指向别处
    - remote URL 被改过

  确认要改推送目标的话，先看 .githooks/pre-push 里的白名单。

============================================================

EOF
exit 1
